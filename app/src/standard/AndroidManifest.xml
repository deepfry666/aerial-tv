<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name="app.orchard.tv.MainActivity">
            <!-- CVTE firmware (ro.CVT_EN_COMMON_HOME_INTENT=1) sends Home and boot as MAIN + HOME + COMMON_HOME,
                 which only matches a filter listing all of them. Extra filter categories do not prevent a
                 plain HOME intent from matching. Reported on cleanyourtv #1201; not verified on a CVTE set here. -->
            <!-- NEWBOX (Android 9, #946) sends HOME + LAUNCHER together. Extend the existing HOME
                 filter so ordinary HOME and CVTE COMMON_HOME still use a single HOME filter. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.COMMON_HOME" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Coocaa's private Home category, which its firmware picks the launcher by (Skyworth
                 9S52_Q4A, Android 6, issue #397; also what makes Dangbei's launcher selectable there).
                 Not verified to change the boot launcher yet. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME.CC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
